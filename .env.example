# ── Contracts (Hardhat) ─────────────────────────────────────────────────────
# Deployer private key (no 0x prefix). Never commit a real key.
PRIVATE_KEY=

# Base Sepolia RPC URL (Alchemy, Infura, QuickNode, or the public endpoint)
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Etherscan V2 API key — used for BaseScan verification
BASESCAN_API_KEY=

# Set to "true" to print gas usage during tests
REPORT_GAS=

# Frontend variables live in frontend/.env.local — see frontend/.env.local.example
