# Wallet private key for contract deployment (no 0x prefix)
PRIVATE_KEY=your_private_key_here

# Base Sepolia RPC URL (from Alchemy, Infura, or QuickNode)
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# BaseScan API key for contract verification
BASESCAN_API_KEY=your_basescan_api_key_here

# WalletConnect Project ID (from cloud.walletconnect.com)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id_here

# Pinata IPFS credentials (from app.pinata.cloud)
PINATA_API_KEY=your_pinata_api_key_here
PINATA_SECRET_API_KEY=your_pinata_secret_here
PINATA_JWT=your_pinata_jwt_here

# Deployed contract addresses (populated after Day 14)
NEXT_PUBLIC_COSIGNED_ADDRESS=
NEXT_PUBLIC_COSIGNED_NFT_ADDRESS=
