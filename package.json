{
  "name": "cosigned",
  "version": "1.0.0",
  "description": "CoSigned is a Web3 DApp where mentors and learners co-sign skill Bonds on-chain. When both parties sign, a soulbound (non-transferable) NFT is minted to each — permanent, verifiable proof that a real mentorship happened. Neither party can fake it alone.",
  "main": "hardhat.config.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "compile":        "hardhat compile",
    "test":           "hardhat test",
    "copy-abis":      "node scripts/copy-abis.js",
    "deploy:local":   "hardhat run scripts/deploy.js --network hardhat",
    "deploy:testnet": "hardhat run scripts/deploy.js --network baseSepolia",
    "verify":         "hardhat verify --network baseSepolia",
    "clean":          "hardhat clean"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Omachilda-Dev1/CoSigned.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/Omachilda-Dev1/CoSigned/issues"
  },
  "homepage": "https://github.com/Omachilda-Dev1/CoSigned#readme",
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "dotenv": "^17.4.1",
    "hardhat": "^2.28.6"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^4.9.6"
  }
}
