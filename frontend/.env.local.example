# Copy to .env.local and fill in what you need. Everything is optional for local dev.

# WalletConnect (cloud.reown.com) — enables mobile / QR wallets
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Pinata JWT (app.pinata.cloud) — SERVER-ONLY, never prefix with NEXT_PUBLIC_
PINATA_JWT=

# Canonical site URL for share links and QR codes
NEXT_PUBLIC_SITE_URL=https://co-signed.vercel.app

# Optional overrides
NEXT_PUBLIC_COSIGNED_ADDRESS=
NEXT_PUBLIC_COSIGNED_NFT_ADDRESS=
NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=
